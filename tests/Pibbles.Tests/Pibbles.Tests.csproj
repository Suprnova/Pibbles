<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFrameworks>net10.0</TargetFrameworks>
    <TargetFrameworks Condition="'$(TestAllTargets)' == 'true'">net8.0;net10.0</TargetFrameworks>
    <IsPackable>false</IsPackable>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <!-- Test names are Unit_Scenario_ExpectedBehavior. -->
    <NoWarn>$(NoWarn);CA1707</NoWarn>
    <!-- Verify's maintenance-fee check: Pibbles is open source and generates no revenue. Renew before the date passes. -->
    <Verify_SponsorshipExemption>OpenSource</Verify_SponsorshipExemption>
    <Verify_SponsorshipExemptionUntil>2027-09</Verify_SponsorshipExemptionUntil>
  </PropertyGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CsCheck" Version="4.9.1" />
    <PackageReference Include="Verify.XunitV3" Version="33.2.0" />
    <PackageReference Include="xunit.v3.mtp-v2" Version="4.0.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Pibbles\Pibbles.csproj" />
  </ItemGroup>

  <!-- The CLI targets net10.0 only, like every tool, so its tests, and the determinism property that plays transcripts, only build for net10.0. -->
  <ItemGroup Condition="'$(TargetFramework)' == 'net10.0'">
    <ProjectReference Include="..\..\src\Pibbles.Cli\Pibbles.Cli.csproj" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' != 'net10.0'">
    <Compile Remove="Cli/**" />
    <Compile Remove="Properties/DeterminismTests.cs" />
  </ItemGroup>

</Project>
