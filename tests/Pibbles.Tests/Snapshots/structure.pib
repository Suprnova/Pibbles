// A file's structure: a prefix, declarations, then nodes, with variable declarations between them and at the end.

@prefix kitchen

@actor mira
    name: Mira
@var $door_open = false

== .door #was:.front_door #was:kitchen.entrance
@if $door_open
    @jump .leave
    mira: Already open.
mira: Locked.
-> Knock
    @call common.knock #id:k7qp2x #thought
    @return
@end

@var $.knocks = 0
// A comment inside the run.

@var $.left = false
== .leave
@once
    mira: Only the first time.
@end // A comment after a statement.

== common.knock
@return
@var $last_knock = 0
