// A relative name needs a `@prefix` to be relative to.

@var $.attempts = 0
//   ^^^^^^^^^^ PIB2021
@var $kitchen.tries = 0
@var $lights = false

== .door
// ^^^^^ PIB2021
== kitchen.cellar #was:.old_cellar
//                     ^^^^^^^^^^^ PIB2021
@if visits(.cellar) > 0
//         ^^^^^^^ PIB2021
    Back in the cellar.
@set $.attempts += 1
//   ^^^^^^^^^^ PIB2021
Tried {$.attempts} times.
//     ^^^^^^^^^^ PIB2021
@jump .leave
//    ^^^^^^ PIB2021

// Must not trigger

== kitchen.leave #was:kitchen.exit
@set $kitchen.tries += 1
@if $lights
    Tried {$kitchen.tries} times.
@jump kitchen.cellar
