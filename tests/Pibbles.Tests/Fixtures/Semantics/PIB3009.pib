// A result of constants too large or too small for a number to hold is clamped.

@var $x = 1
@var $t = 1s

== fixture.overflow
@set $x = 99999999999999999999999999 * 99999999999999999999999999
//        ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^ PIB3009
@set $x = 79228162514264337593543950335 + 1
//        ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^ PIB3009
@set $x = -79228162514264337593543950335 - 1
//        ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^ PIB3009
@set $x = 79228162514264337593543950335 / 0.1
//        ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^ PIB3009
@set $t = 79228162514264337593543950335s + 1s
//        ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^ PIB3009
@set $x = 99999999999999999999999999 * 99999999999999999999999999 * 2
//        ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^ PIB3009

// Must not trigger

@set $x = 79228162514264337593543950335 - 1
@set $x = 79228162514264337593543950335 * 0
@set $x = 79228162514264337593543950335 / 1
@set $x = 79228162514264337593543950335 % 3
@set $x = $x * 99999999999999999999999999
@set $x = 0.1 + 0.2
