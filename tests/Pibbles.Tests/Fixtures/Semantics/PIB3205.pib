// A speed or a pause written as a constant has to be more than zero.

@var $s = 1
@var $d = 1s

== kitchen.door
A {speed 0} B.
//       ^ PIB3205
A {speed (-1)} B.
//       ^^^^ PIB3205
A {speed (2 * 0)} B.
//       ^^^^^^^ PIB3205
A {pause 0} B.
//       ^ PIB3205
A {pause 0s} B.
//       ^^ PIB3205
A {pause (0.5s - 1s)} B.
//       ^^^^^^^^^^^ PIB3205
@pause 0s
//     ^^ PIB3205

// Must not trigger

A {pause 0.1} B {speed $s} C {pause $d} D {speed 0.5} E {speed} F.
@pause 0.5s
