// Names are written in snake_case. A display name is what the player sees, so it's written any way.

@channel pose
@channel CameraMove
//       ^^^^^^^^^^ PIB5303
@actor Mira
//     ^^^^ PIB5303
    name: Mira Rivers
    pose: neutral, VeryHappy
//                 ^^^^^^^^^ PIB5303
@var $HasKey = false
//   ^^^^^^^ PIB5303
@enum Room: Kitchen, cellar
//    ^^^^ PIB5303
//          ^^^^^^^ PIB5303

== Kitchen.FrontDoor
// ^^^^^^^^^^^^^^^^^ PIB5303
@if $HasKey
    Narration.

// Must not trigger

== kitchen.front_door
Narration.
