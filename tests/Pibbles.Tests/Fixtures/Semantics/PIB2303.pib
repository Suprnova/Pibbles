// A value has the type of the variable, parameter or statement it's for.

@enum position: left, right
@var $has_key = false
@var $count: number = "none"
//                    ^^^^^^ PIB2303
@command show(at: position = 1)
//                           ^ PIB2303

== kitchen.door
@set $has_key = 3
//              ^ PIB2303
@pause "soon"
//     ^^^^^^ PIB2303
@set $count += 1s
//             ^^ PIB2303

// Must not trigger

@pause 1
@set $count += 2
