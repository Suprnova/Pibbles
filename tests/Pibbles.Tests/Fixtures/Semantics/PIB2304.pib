// A variable that starts as a name has its type written, so declaring a new name never changes it.

@enum position: left, right
@enum side: left, right
@actor mira
    name: Mira
@var $where = right
//            ^^^^^ PIB2304
@var $speaker = mira
//              ^^^^ PIB2304
@var $next = kitchen.door
//           ^^^^^^^^^^^^ PIB2304

// Must not trigger

@var $there: position = left
@var $count = -1
@var = right
//  ^ PIB1107

== kitchen.door
