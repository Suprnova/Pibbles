// A command is declared with `@command` before the story uses it.

@command shake_screen(strength: number = 1) inline

== kitchen.door
@shake_scren
// PIB2604
The room shakes.{@quake}
//                ^^^^^ PIB2604
@wait 1s
// PIB2604

// Must not trigger

@shake_screen
The room shakes.{@shake_screen 2}

== kitchen.sink
@pause 1s
