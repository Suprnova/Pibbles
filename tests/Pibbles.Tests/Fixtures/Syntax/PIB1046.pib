// Some lines need a name or a value after their keyword.

@actor mira
    name: 
//       ^ PIB1046
== fixture.missing #was:
//                      ^ PIB1046
@jump
//   ^ PIB1046
@call #id:k7qp2x
//   ^ PIB1046
@prefix
// PIB1020
@set $x = 1 +
//           ^ PIB1046
@set
//  ^ PIB1046
@set $x
//     ^ PIB1046
@set $x =
//       ^ PIB1046
@wait
//   ^ PIB1046
@if 
// ^ PIB1046
    @end
@show mira at=
//            ^ PIB1046
@set $x = f(1,)
//            ^ PIB1046
==
//^ PIB1046
== fixture.alias #was
//                   ^ PIB1046
== fixture.dot #was:.
//                  ^ PIB1046

// Must not trigger

== fixture.renamed #was:fixture.old #was:.older
@jump fixture.renamed
@call .relative #id:k7qp2x
@set $x = f()
