mira: A line\nbreak.
//          ^^ PIB1014
mira: Ends with a backslash\
//                         ^ PIB1014
-> Option \t text
//        ^^ PIB1014

// Must not trigger

@set $x = "A \"quote\" and a backslash \\ inside."
@set $x = "\# \{ \[ \: \@ \$ \~"
mira: \[ \] \{ \} \# \: \@ \\ \" \~
