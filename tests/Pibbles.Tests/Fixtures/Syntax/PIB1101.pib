// A backslash only goes before punctuation, in text and in quoted strings.

== fixture.escapes
@set $x = "First line\nsecond line"
//                   ^^ PIB1101
@set $x = "C:\Users"
//           ^^ PIB1101
@set $x = "Tab\9"
//            ^^ PIB1101
mira: A line\nbreak.
//          ^^ PIB1101
mira: Ends with a backslash\
//                         ^ PIB1101
-> Option \t text
//        ^^ PIB1101
mira: A \あ escape.
//      ^^ PIB1101

// Must not trigger

@set $x = "A \"quote\" and a backslash \\ inside."
@set $x = "\# \{ \[ \: \@ \$ \~"
mira: \[ \] \{ \} \# \: \@ \\ \" \~
mira: \： \＠ \。 \「 \￥
