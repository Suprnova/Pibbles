// @elif and @else belong to the @if directly above them.

== fixture.clauses
@else
// PIB2201
    The statements under it still count.
@if $a
    @end
@else
    @end
@elif $b
// PIB2201
    @end
@if $a
    @end
A line in between.
@else
// PIB2201
    @end

// Must not trigger

@if $a
    @end
// A comment between clauses is fine.
@elif $b
    @end
@else
    @end
