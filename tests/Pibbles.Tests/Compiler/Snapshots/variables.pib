// @set with =, += and -=, durations and numbers together, and @pause.

== snap.variables
@set $count = 5
@set $count += 1
@set $count -= 2 * 3
@set $delay += 1
@set $delay -= 0.5s
@set $name += "!"
@set $has_key = not $has_key
@set $where = right
@set $delay = $delay * 2
@pause 1
@pause 0.5s + (1 + 2)
@pause $delay
@if $delay > 2
    @pause ($delay / 2)
