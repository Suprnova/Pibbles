<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>pibbles</ToolCommandName>
    <!-- The CLI can be published trimmed as a single executable, so every build checks for code trimming would break. -->
    <EnableTrimAnalyzer>true</EnableTrimAnalyzer>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Pibbles\Pibbles.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Pibbles.Tests" />
    <EmbeddedResource Include="..\..\docs\diagnostics.md" LogicalName="diagnostics.md" />
    <EmbeddedResource Include="Projects\Starter\*.pib" LogicalName="Starter/%(Filename)%(Extension)" />
  </ItemGroup>

  <!--
    A published executable is named after the command, pibbles, not the project. The assembly keeps its name: a pibbles.dll
    would clash with the core's Pibbles.dll on file systems that ignore case. The executable finds its assembly by name.
  -->
  <Target Name="NameExecutableAfterCommand" AfterTargets="Publish">
    <Move SourceFiles="$(PublishDir)$(AssemblyName).exe" DestinationFiles="$(PublishDir)$(ToolCommandName).exe" Condition="Exists('$(PublishDir)$(AssemblyName).exe')" />
    <Move SourceFiles="$(PublishDir)$(AssemblyName)" DestinationFiles="$(PublishDir)$(ToolCommandName)" Condition="Exists('$(PublishDir)$(AssemblyName)')" />
  </Target>

  <ItemGroup>
    <PackageReference Include="editorconfig" Version="0.18.0" />
    <PackageReference Include="System.CommandLine" Version="2.0.12" />
  </ItemGroup>

</Project>
