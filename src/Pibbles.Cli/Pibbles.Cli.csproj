<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>pibbles</ToolCommandName>
    <!-- The CLI can be published trimmed as a single executable, so every build checks for code trimming would break. -->
    <EnableTrimAnalyzer>true</EnableTrimAnalyzer>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Pibbles\Pibbles.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Pibbles.Tests" />
    <EmbeddedResource Include="..\..\docs\diagnostics.md" LogicalName="diagnostics.md" />
    <EmbeddedResource Include="Starter\*.pib" LogicalName="Starter/%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="System.CommandLine" Version="2.0.12" />
  </ItemGroup>

</Project>
