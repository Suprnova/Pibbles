// SYNTAX TEST "source.pibbles" "comments, notes, headers, text lines and tags"

// A comment line.
// <-- comment.line.double-slash.pibbles punctuation.definition.comment.pibbles
//   ^^^^^^^ comment.line.double-slash.pibbles

/// A note, reserved for localization.
// <------ comment.line.note.pibbles

//// A banner is a comment.
// <---- comment.line.double-slash.pibbles - comment.line.note.pibbles

== kitchen.fridge #was:kitchen.icebox // The old name still works.
// <-- meta.header.pibbles keyword.control.header.pibbles
// ^^^^^^^^^^^^^^ entity.name.section.node.pibbles
//                ^^^^ meta.tag.pibbles entity.name.tag.pibbles
//                    ^ punctuation.separator.key-value.pibbles
//                     ^^^^^^^^^^^^^^ entity.name.section.node.pibbles
//                                    ^^ comment.line.double-slash.pibbles punctuation.definition.comment.pibbles

== .door
// ^^^^^ entity.name.section.node.pibbles

The kitchen smells of old coffee. #thought
// <---------------------------------- - entity.name.type.speaker.pibbles
//                                ^^^^^^^^ meta.tag.pibbles entity.name.tag.pibbles

mira: Hello there. #box:phone #id:k7qp2x
// <---- entity.name.type.speaker.pibbles
//  ^ punctuation.separator.speaker.pibbles
//                 ^^^^ meta.tag.pibbles entity.name.tag.pibbles
//                     ^ punctuation.separator.key-value.pibbles
//                      ^^^^^ string.unquoted.tag-value.pibbles
//                            ^^^^^^^^^^ comment.other.line-id.pibbles

mira (smug): I knew you'd come.
// <---- entity.name.type.speaker.pibbles
//   ^ punctuation.definition.values.pibbles
//    ^^^^ constant.other.channel-value.pibbles
//        ^ punctuation.definition.values.pibbles
//         ^ punctuation.separator.speaker.pibbles

mira (sad):
//    ^^^ constant.other.channel-value.pibbles

mira (mad, shake , pan_left): Several values, in any order.
// <---- entity.name.type.speaker.pibbles
//   ^ punctuation.definition.values.pibbles
//    ^^^ constant.other.channel-value.pibbles
//         ^^^^^ constant.other.channel-value.pibbles
//                 ^^^^^^^^ constant.other.channel-value.pibbles
//                         ^ punctuation.definition.values.pibbles
//                          ^ punctuation.separator.speaker.pibbles

(orbit_scene): Narration sets values too.
// <- punctuation.definition.values.pibbles
//^^^^^^^^^^ constant.other.channel-value.pibbles
//          ^ punctuation.definition.values.pibbles
//           ^ punctuation.separator.speaker.pibbles

(shake):
// <- punctuation.definition.values.pibbles
//^^^^ constant.other.channel-value.pibbles

(An aside) and more: a parenthesis with no colon after it is plain text.
// <- - punctuation.definition.values.pibbles
//  ^^^^^ - constant.other.channel-value.pibbles

mira（smug）：I knew you'd come.
// <---- entity.name.type.speaker.pibbles
//  ^ punctuation.definition.values.pibbles
//   ^^^^ constant.other.channel-value.pibbles
//       ^ punctuation.definition.values.pibbles
//        ^ punctuation.separator.speaker.pibbles

mira (happy、shake): Several values, mixed punctuation.
// <---- entity.name.type.speaker.pibbles
//    ^^^^^ constant.other.channel-value.pibbles
//          ^^^^^ constant.other.channel-value.pibbles
//                ^ punctuation.separator.speaker.pibbles

mira：No space needed after a full-width colon.
// <---- entity.name.type.speaker.pibbles
//  ^ punctuation.separator.speaker.pibbles

（shake）：Narration sets values too.
// <- punctuation.definition.values.pibbles
//^^^^ constant.other.channel-value.pibbles
//    ^ punctuation.definition.values.pibbles
//     ^ punctuation.separator.speaker.pibbles

他说\：“你好。”
// <-- - entity.name.type.speaker.pibbles
//^^ constant.character.escape.pibbles

Note\: the door is locked. Not \#winning, but my #1 fan.
// <---- - entity.name.type.speaker.pibbles
//  ^^ constant.character.escape.pibbles
//                             ^^ constant.character.escape.pibbles
//                                               ^^ - meta.tag.pibbles

If you say so.
// <-- - keyword.control.pibbles

#idea is a tag, but #identity isn't an ID.
// <----- meta.tag.pibbles - comment.other.line-id.pibbles
//                  ^^^^^^^^^ meta.tag.pibbles - comment.other.line-id.pibbles

mira: Hello there. // Said warmly.
//    ^^^^^^^^^^^^ - comment.line.double-slash.pibbles
//                 ^^ comment.line.double-slash.pibbles punctuation.definition.comment.pibbles
//                   ^^^^^^^^^^^^^ comment.line.double-slash.pibbles

Visit https:\//example.com for the recipe.
//          ^^ constant.character.escape.pibbles
//             ^^^^^^^^^^^^^^^^^^^^^^^^^^^ - comment.line.double-slash.pibbles

mira: Read #link:https://example.com // After the tag.
//         ^^^^^ meta.tag.pibbles entity.name.tag.pibbles
//               ^^^^^^^^^^^^^^^^^^^ string.unquoted.tag-value.pibbles - comment.line.double-slash.pibbles
//                                   ^^ comment.line.double-slash.pibbles punctuation.definition.comment.pibbles
//                                     ^^^^^^^^^^^^^^^ comment.line.double-slash.pibbles

mira: Hi. #thought//Right after the tag.
//        ^^^^^^^^ meta.tag.pibbles entity.name.tag.pibbles
//                ^^^^^^^^^^^^^^^^^^^^^^ comment.line.double-slash.pibbles

mira: Hello. /// Not a note.
//           ^^^^^^^^^^^^^^^ invalid.illegal.note-in-line.pibbles - comment.line.double-slash.pibbles

mira: Hello. //// A banner.
//           ^^^^^^^^^^^^^^ comment.line.double-slash.pibbles - invalid.illegal.note-in-line.pibbles

-> Leave @if $has_key // The polite exit.
// <-- keyword.control.option.pibbles
//       ^^^ keyword.control.modifier.pibbles
//                    ^^ comment.line.double-slash.pibbles punctuation.definition.comment.pibbles
//                      ^^^^^^^^^^^^^^^^^ comment.line.double-slash.pibbles

-> Wave // Friendly.
// ^^^^ - comment.line.double-slash.pibbles
//      ^^^^^^^^^^^^ comment.line.double-slash.pibbles

- mira: Hello. // Said warmly.
// <- keyword.control.alternative.pibbles
//^^^^ entity.name.type.speaker.pibbles
//             ^^^^^^^^^^^^^^^ comment.line.double-slash.pibbles

mira: Hi, {$name // The brace is never closed.
//        ^ meta.point.pibbles punctuation.definition.point.pibbles
//         ^^^^^ variable.other.pibbles
//               ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^ comment.line.double-slash.pibbles

mira: Hi {f("a//b")} // The string keeps its slashes.
//          ^^^^^^ string.quoted.double.pibbles - comment.line.double-slash.pibbles
//                   ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^ comment.line.double-slash.pibbles

// Every space separator counts as whitespace, as in the compiler.

guide :　Bonjour.
// <----- entity.name.type.speaker.pibbles
//    ^ punctuation.separator.speaker.pibbles

mira: Hi #box:phone　#thought
//            ^^^^^ string.unquoted.tag-value.pibbles
//                  ^^^^^^^^ meta.tag.pibbles entity.name.tag.pibbles

->　Go
// <-- keyword.control.option.pibbles

-　mira: Hello.
// <- keyword.control.alternative.pibbles
//^^^^ entity.name.type.speaker.pibbles

==　kitchen.door
// ^^^^^^^^^^^^ entity.name.section.node.pibbles

// Only spaces and tabs indent.

　　mira: Hello.
// <-- invalid.illegal.indentation.pibbles
//^^^^ entity.name.type.speaker.pibbles

   -> Go
// <--- invalid.illegal.indentation.pibbles
// ^^ keyword.control.option.pibbles

　== kitchen.door
// <- invalid.illegal.indentation.pibbles
//^ keyword.control.header.pibbles

　// A comment may start with one.
// <- comment.line.double-slash.pibbles - invalid.illegal.indentation.pibbles

mira: Done!　Next.
//         ^ - invalid.illegal.indentation.pibbles

@actor mira
　name: Mira
// <- invalid.illegal.indentation.pibbles

    name: Mira
//  ^^^^ support.type.property-name.pibbles - invalid.illegal.indentation.pibbles
