{
  "name": "pibbles",
  "displayName": "Pibbles",
  "description": "Syntax highlighting, snippets and editing aids for Pibbles, a narrative scripting language for visual novels.",
  "version": "0.1.5",
  "publisher": "pibbles",
  "license": "MIT",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/Suprnova/Pibbles.git",
    "directory": "editors/vscode"
  },
  "engines": {
    "vscode": "^1.101.0"
  },
  "categories": [
    "Programming Languages",
    "Snippets"
  ],
  "main": "./out/src/extension.js",
  "activationEvents": [
    "onLanguage:pibbles"
  ],
  "scripts": {
    "build": "tsc -p . && node scripts/build.js",
    "test": "npm run build && node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --test \"tests/unit/*.test.ts\" && vscode-tmgrammar-test \"tests/*.pib\" && node scripts/check-scopes.js",
    "package": "npm run build && vsce package"
  },
  "contributes": {
    "languages": [
      {
        "id": "pibbles",
        "aliases": [
          "Pibbles"
        ],
        "extensions": [
          ".pib"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "pibbles",
        "scopeName": "source.pibbles",
        "path": "./syntaxes/pibbles.tmLanguage.json"
      }
    ],
    "snippets": [
      {
        "language": "pibbles",
        "path": "./snippets/pibbles.json"
      }
    ],
    "configurationDefaults": {
      "cSpell.enabledFileTypes": {
        "pibbles": true
      },
      "cSpell.customDictionaries": {
        "pibbles-words": {
          "name": "pibbles-words",
          "path": "${workspaceFolder}/story/words.txt",
          "addWords": true,
          "scope": "workspace"
        }
      },
      "cSpell.languageSettings": [
        {
          "languageId": "pibbles",
          "dictionaries": [
            "pibbles-words"
          ],
          "ignoreRegExpList": [
            "/^[ \\t]*@.*$/gm",
            "/^[ \\t]*==.*$/gm",
            "/\\/\\/.*$/gm",
            "/^[ \\t]*[\\p{L}_][\\p{L}\\p{M}\\p{Nd}_]*[ \\t]*(\\([^)]*\\))?[ \\t]*:(?=[ \\t]|$)/gmu",
            "/#\\p{L}\\S*/gu",
            "/\\[[^\\]]*\\]/g",
            "/\\{[^}]*\\}/g",
            "/(?<=->.*)@\\p{L}.*$/gmu"
          ]
        }
      ]
    },
    "commands": [
      {
        "command": "pibbles.selectLineId",
        "title": "Select Line ID",
        "category": "Pibbles"
      }
    ],
    "keybindings": [
      {
        "command": "pibbles.cursorEnd",
        "key": "end",
        "mac": "cmd+right",
        "when": "editorTextFocus && editorLangId == pibbles && config.pibbles.lineIds.skipWithCursor"
      },
      {
        "command": "pibbles.cursorEndSelect",
        "key": "shift+end",
        "mac": "shift+cmd+right",
        "when": "editorTextFocus && editorLangId == pibbles && config.pibbles.lineIds.skipWithCursor"
      },
      {
        "command": "pibbles.cursorRight",
        "key": "right",
        "when": "editorTextFocus && editorLangId == pibbles && config.pibbles.lineIds.skipWithCursor"
      },
      {
        "command": "pibbles.selectLineId",
        "key": "ctrl+alt+i",
        "mac": "cmd+alt+i",
        "when": "editorTextFocus && editorLangId == pibbles"
      },
      {
        "command": "pibbles.enter",
        "key": "enter",
        "when": "editorTextFocus && editorLangId == pibbles && !editorReadonly && !editorHasSelection && !editorHasMultipleSelections && !suggestWidgetVisible && !inlineSuggestionVisible && !inSnippetMode"
      },
      {
        "command": "pibbles.tab",
        "key": "tab",
        "when": "editorTextFocus && editorLangId == pibbles && !editorReadonly && !editorHasSelection && !editorHasMultipleSelections && !suggestWidgetVisible && !inlineSuggestionVisible && !inSnippetMode && !editorTabMovesFocus"
      }
    ],
    "configuration": {
      "title": "Pibbles",
      "properties": {
        "pibbles.lineIds.skipWithCursor": {
          "type": "boolean",
          "default": true,
          "description": "Move the cursor as if a line's trailing `#id:` weren't there: End, Shift+End and Right stop before it, and a click past the end of a line lands before it."
        }
      }
    }
  },
  "devDependencies": {
    "@types/node": "^24.19.1",
    "@types/vscode": "~1.101.0",
    "@vscode/vsce": "^4.0.0",
    "js-yaml": "^5.4.2",
    "typescript": "^7.0.2",
    "vscode-tmgrammar-test": "^0.1.3"
  }
}
